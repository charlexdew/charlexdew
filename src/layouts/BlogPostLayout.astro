---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const title = `${frontmatter.title} // charlexdew`;
const description = frontmatter.description ?? 'A blog post from charlexdew.';
const pubDate = frontmatter.pubDate ? new Date(frontmatter.pubDate) : undefined;
const tags = frontmatter.tags ?? [];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title={title} description={description}>
  <article class="panel article">
    <a class="back" href={`${base}blog/`}>← back to blog</a>
    <header>
      <p class="section-label">log entry</p>
      <h1>{frontmatter.title}</h1>
      {pubDate && <p class="meta">{pubDate.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</p>}
      <div class="tags">
        {tags.map((tag: string) => <span class="pill">#{tag}</span>)}
      </div>
    </header>
    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article { margin-top: 3rem; padding: clamp(1.2rem, 4vw, 3rem); }
  .back { display: inline-flex; margin-bottom: 2rem; color: var(--muted); }
  h1 { font-size: clamp(2.4rem, 7vw, 5rem); line-height: 1; letter-spacing: -0.07em; margin: 0; }
  .meta { color: var(--green); }
  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0 2rem; }
  .content { color: var(--text); font-size: 1.05rem; line-height: 1.85; }
  .content :global(p), .content :global(li) { color: var(--muted); }
  .content :global(h2) { margin-top: 2rem; color: var(--text); }
  .content :global(pre) { border: 1px solid var(--line); border-radius: 18px; background: rgba(0,0,0,0.35); }
  .content :global(code) { border-radius: 8px; }
</style>
