---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal site and blog of charlexdew.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#00ff9c" />
  </head>
  <body>
    <div class="scanline" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={base} aria-label="charlexdew home">
        <span class="prompt">~/</span>charlexdew<span class="cursor">_</span>
      </a>
      <nav>
        <a href={base}>Home</a>
        <a href={`${base}blog/`}>Blog</a>
        <a href="https://github.com/charlexdew" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Built from caffeine, commits, and questionable shell aliases.</p>
      <p><code>status: online</code> · <code>mode: geek</code> · <code>shell: /bin/brain</code></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #05070a;
    --panel: rgba(11, 18, 32, 0.76);
    --panel-strong: rgba(15, 23, 42, 0.94);
    --text: #d7fff1;
    --muted: #8ea7a0;
    --green: #00ff9c;
    --cyan: #45d9ff;
    --pink: #ff4fd8;
    --yellow: #ffdf6b;
    --line: rgba(0, 255, 156, 0.18);
    --shadow: 0 0 40px rgba(0, 255, 156, 0.16);
  }

  * { box-sizing: border-box; }

  html {
    background: var(--bg);
    min-height: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    color: var(--text);
    background:
      radial-gradient(circle at 20% 10%, rgba(69, 217, 255, 0.18), transparent 28rem),
      radial-gradient(circle at 82% 20%, rgba(255, 79, 216, 0.13), transparent 24rem),
      radial-gradient(circle at 50% 90%, rgba(0, 255, 156, 0.12), transparent 30rem),
      linear-gradient(180deg, #05070a 0%, #070b12 100%);
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.32;
    background-image:
      linear-gradient(rgba(0, 255, 156, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 156, 0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black, transparent 80%);
  }

  .scanline {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.035) 1px,
      transparent 1px,
      transparent 4px
    );
    mix-blend-mode: overlay;
  }

  a { color: var(--green); text-decoration: none; }
  a:hover { color: var(--cyan); text-shadow: 0 0 14px currentColor; }

  main, .site-header, .site-footer {
    width: min(1120px, calc(100% - 32px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    position: relative;
    z-index: 2;
  }

  .brand {
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--text);
  }

  .prompt { color: var(--green); }
  .cursor { color: var(--green); animation: blink 1s steps(1) infinite; }

  nav { display: flex; gap: 1rem; flex-wrap: wrap; }
  nav a { color: var(--muted); font-size: 0.92rem; }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
    padding: 2rem 0 3rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  code, .pill {
    border: 1px solid var(--line);
    background: rgba(0, 255, 156, 0.07);
    color: var(--green);
    border-radius: 999px;
    padding: 0.2rem 0.48rem;
  }

  .section-label {
    color: var(--green);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.78rem;
    margin: 0 0 0.8rem;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(145deg, var(--panel), rgba(5, 7, 10, 0.68));
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .glitch {
    position: relative;
    text-shadow:
      2px -1px 0 rgba(69, 217, 255, 0.45),
      -2px 1px 0 rgba(255, 79, 216, 0.42),
      0 0 24px rgba(0, 255, 156, 0.36);
  }

  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 720px) {
    .site-header { align-items: flex-start; flex-direction: column; }
    nav { gap: 0.75rem; }
  }
</style>
