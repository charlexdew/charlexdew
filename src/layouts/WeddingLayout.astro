---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Servicios de fotografía y video de boda.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fbf7f0" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}fotografia-bodas/`} aria-label="Sami y Abi fotografía de bodas">
        <span>Sami & Abi</span>
        <small>Fotografía de bodas</small>
      </a>
      <nav aria-label="Secciones de la página">
        <a href={`${base}fotografia-bodas/`}>Romántico</a>
        <a href={`${base}fotografia-bodas-clasica/`}>Clásico</a>
        <a href={`${base}fotografia-bodas-minimalista/`}>Minimal</a>
        <a href={`${base}fotografia-bodas-presupuesto/`}>PDF</a>
        <a href={`${currentPath}#paquetes`}>Paquetes</a>
        <a class="nav-cta" href={`${currentPath}#contacto`}>Contacto</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Sami Veliz & Abigail Ramírez · Fotografía y video para bodas religiosas, civiles y recepciones.</p>
      <p><a href="mailto:abigailrfotografia@hotmail.com">abigailrfotografia@hotmail.com</a> · <a href="tel:+593987896284">0987896284</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  html { min-height: 100%; background: #fbf7f0; scroll-behavior: smooth; }
  body {
    margin: 0;
    min-height: 100vh;
    color: #3f332c;
    background: #fbf7f0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { color: #a77266; }
  main, .site-header, .site-footer {
    width: min(1160px, calc(100% - 32px));
    margin-inline: auto;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgba(90, 67, 52, 0.12);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.86);
    box-shadow: 0 20px 60px rgba(90, 67, 52, 0.08);
    backdrop-filter: blur(18px);
    position: relative;
    z-index: 5;
  }
  .brand {
    display: grid;
    color: #3f332c;
    line-height: 1;
  }
  .brand span {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .brand small {
    margin-top: 0.18rem;
    color: #74665d;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  nav { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  nav a {
    color: #74665d;
    font-size: 0.92rem;
    font-weight: 800;
    padding: 0.6rem 0.78rem;
    border-radius: 999px;
  }
  nav a:hover { background: rgba(135, 151, 125, 0.12); color: #52604b; }
  .nav-cta {
    color: #fffdf8;
    background: #87977d;
    box-shadow: 0 10px 25px rgba(82, 96, 75, 0.16);
  }
  .nav-cta:hover { color: #fffdf8; background: #6f8166; }
  .site-footer {
    border-top: 1px solid rgba(90, 67, 52, 0.16);
    margin-top: 5rem;
    padding: 2rem 0 3rem;
    color: #74665d;
    font-size: 0.92rem;
    text-align: center;
    line-height: 1.7;
  }
  .site-footer a { color: #52604b; font-weight: 800; }
  @media (max-width: 720px) {
    .site-header { align-items: flex-start; flex-direction: column; border-radius: 24px; }
    nav { width: 100%; }
  }
</style>
