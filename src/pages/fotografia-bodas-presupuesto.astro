---
import WeddingLayout from '../layouts/WeddingLayout.astro';

const packages = [
  {
    name: 'Standard',
    price: '$300',
    tone: 'Ceremonia + recepción',
    features: [
      'Cobertura de ceremonia en fotografía y video — 2 horas',
      'Cobertura de recepción en fotografía y video — 3 horas',
      '150 fotos editadas y digitales',
      '1 video resumen de 3 minutos',
    ],
  },
  {
    name: 'Premium',
    price: '$400',
    tone: 'Pre-boda + 6 horas',
    featured: true,
    features: [
      'Sesión pre-boda al aire libre de 60 minutos*',
      'Incluye 10 fotos de la sesión pre-boda',
      '6 horas de cobertura en fotografía y video para ceremonia y recepción',
      '250 fotos editadas y digitales',
      '1 video de 5 minutos',
    ],
  },
  {
    name: 'Gold',
    price: '$600',
    tone: 'Cobertura completa',
    features: [
      'Sesión pre-boda al aire libre de 90 minutos*',
      'Incluye 20 fotos de la sesión pre-boda',
      '8 horas de cobertura de todo el evento: preparación, ceremonia y recepción',
      'Tomas de drone',
      '350 fotos editadas y digitales',
      '1 a 2 videos resumen — 3 minutos en total',
      '1 video de 10 minutos',
    ],
  },
];

---
<WeddingLayout
  title="Presupuesto de cobertura de boda por Sami & Abi"
  description="Página con estética similar al PDF de presupuesto de cobertura de boda, con paquetes Standard, Premium y Gold."
>
  <article class="pdf-sheet">
    <header class="pdf-topbar">
      <span>Abigail Ramírez & Sami Veliz</span>
      <span>Presupuesto</span>
    </header>

    <section class="pdf-title">
      <h1>Cobertura de Boda</h1>
      <p>Fotografía y video</p>
    </section>

    <section id="paquetes" class="pdf-packages" aria-label="Paquetes de cobertura de boda">
      {packages.map((item, index) => (
        <article class="pdf-package">
          <div class:list={['arch-photo', `photo-${index + 1}`]} aria-hidden="true">
            <span class="couple-shape one"></span>
            <span class="couple-shape two"></span>
          </div>
          <h2>{item.name}</h2>
          <ul>
            {item.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <p class="price">{item.price.replace('$', '$ ')}</p>
        </article>
      ))}
    </section>

    <section id="reserva" class="pdf-notes">
      <p>*La sesión pre-boda debe realizarse el mismo día del evento. Si se agenda para una fecha diferente, se aplicará un cargo adicional.</p>
      <p>Los paquetes se reservan con el 50% de anticipo y el 50% restante se cancela el día del evento o antes de la entrega final del material.</p>
      <p>El material final se entrega de 3 a 4 semanas después de la boda.</p>
    </section>

    <footer id="contacto" class="pdf-contact">
      <a href="tel:+593979160057" aria-label="Llamar a Abigail Ramírez">
        <span class="icon">☎</span>
        <span>0979160057 / 0987896284</span>
      </a>
      <a href="mailto:abigailrfotografia@hotmail.com?subject=Consulta%20cobertura%20de%20boda%20Sami%20%26%20Abi" aria-label="Enviar correo a Abigail y Sami">
        <span class="icon">✉</span>
        <span>abigailrfotografia@hotmail.com<br />samantaveliz92@gmail.com</span>
      </a>
    </footer>
  </article>
</WeddingLayout>

<style>
  :global(body) {
    --pdf-bg: #e9e9e5;
    --pdf-paper: #eeeeeb;
    --pdf-ink: #050505;
    --pdf-muted: #252525;
    color: var(--pdf-ink);
    background:
      radial-gradient(circle at 20% 10%, rgba(255,255,255,0.54), transparent 18rem),
      linear-gradient(115deg, rgba(255,255,255,0.2), rgba(0,0,0,0.025)),
      var(--pdf-bg);
    font-family: Montserrat, Avenir, 'Helvetica Neue', Arial, sans-serif;
  }

  :global(body)::before {
    opacity: 0.24;
    background-image:
      linear-gradient(100deg, rgba(0,0,0,0.03), transparent 38%),
      radial-gradient(circle at 1px 1px, rgba(0,0,0,0.08) 0.6px, transparent 0);
    background-size: 140px 140px, 5px 5px;
    mix-blend-mode: multiply;
  }

  .pdf-sheet {
    max-width: 1080px;
    margin: clamp(2.5rem, 6vw, 5rem) auto 0;
    padding: clamp(2.2rem, 6vw, 4.6rem) clamp(1.2rem, 5vw, 4.5rem) clamp(2rem, 5vw, 3.6rem);
    background:
      linear-gradient(90deg, rgba(255,255,255,0.18), transparent 28%, rgba(0,0,0,0.018)),
      var(--pdf-paper);
    box-shadow: 0 30px 90px rgba(0,0,0,0.12);
    min-height: 1180px;
  }

  .pdf-topbar { display: flex; justify-content: space-between; gap: 1rem; font-size: clamp(0.78rem, 1.5vw, 1.02rem); font-weight: 300; letter-spacing: 0.02em; }
  .pdf-title { text-align: center; margin: clamp(3.2rem, 8vw, 6.5rem) 0 clamp(2.6rem, 6vw, 4.2rem); }
  h1, h2, p { text-wrap: pretty; }
  .pdf-title h1 { margin: 0; font-family: 'Cormorant Garamond', 'Playfair Display', Didot, Georgia, serif; font-style: italic; font-size: clamp(4.2rem, 9vw, 7.8rem); font-weight: 400; line-height: 0.95; letter-spacing: -0.055em; }
  .pdf-title p { margin: 1rem 0 0; text-transform: uppercase; letter-spacing: 0.48em; font-size: clamp(0.68rem, 1.4vw, 0.95rem); font-weight: 300; }
  .pdf-packages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.4rem, 4vw, 3.4rem); }
  .pdf-package { text-align: center; display: flex; flex-direction: column; align-items: stretch; min-height: 610px; }
  .arch-photo { width: min(100%, 245px); height: clamp(230px, 27vw, 305px); margin: 0 auto; position: relative; overflow: hidden; border-radius: 999px 999px 0 0; background: #d8d8d2; isolation: isolate; }
  .arch-photo::before { content: ''; position: absolute; inset: 0; background: linear-gradient(160deg, rgba(255,255,255,0.28), transparent 42%), radial-gradient(circle at 50% 25%, rgba(255,255,255,0.7), transparent 3.8rem); z-index: 1; }
  .photo-1 { background: linear-gradient(145deg, #d9d5cf, #a9988b 58%, #6d655f); }
  .photo-2 { background: linear-gradient(145deg, #ccd5ca, #8f9d8c 56%, #555e52); }
  .photo-3 { background: linear-gradient(160deg, #efe0c8, #b86f47 55%, #313642); }
  .couple-shape { position: absolute; bottom: -12%; width: 42%; height: 72%; border-radius: 999px 999px 0 0; background: rgba(15,15,15,0.72); filter: blur(0.2px); z-index: 2; }
  .couple-shape.one { left: 18%; transform: rotate(-6deg); }
  .couple-shape.two { right: 17%; height: 66%; transform: rotate(7deg); background: rgba(245,245,241,0.78); }
  .pdf-package h2 { margin: 1.4rem 0 1rem; font-family: 'Cormorant Garamond', 'Playfair Display', Didot, Georgia, serif; font-style: italic; font-weight: 400; font-size: clamp(2.4rem, 4.6vw, 3.8rem); line-height: 1; letter-spacing: -0.04em; }
  .pdf-package ul { margin: 0; padding-left: 1.05rem; text-align: left; display: grid; gap: 0.62rem; font-size: clamp(0.78rem, 1.2vw, 0.92rem); font-weight: 300; line-height: 1.62; }
  .pdf-package li { color: var(--pdf-muted); padding-left: 0.12rem; }
  .price { margin: auto 0 0; padding-top: 2.3rem; font-family: 'Cormorant Garamond', 'Playfair Display', Didot, Georgia, serif; font-size: clamp(2.9rem, 5vw, 4.3rem); font-weight: 400; line-height: 1; letter-spacing: -0.03em; }
  .pdf-notes { max-width: 820px; margin: clamp(2.6rem, 6vw, 4.4rem) auto 0; text-align: center; font-size: clamp(0.76rem, 1.2vw, 0.9rem); font-weight: 300; line-height: 1.7; }
  .pdf-notes p { margin: 0.2rem 0; }
  .pdf-contact { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: clamp(1.8rem, 4vw, 3rem); font-size: clamp(0.78rem, 1.2vw, 0.95rem); font-weight: 300; }
  .pdf-contact a { color: var(--pdf-ink); display: inline-flex; align-items: center; gap: 0.7rem; }
  .icon { font-size: 1.05rem; line-height: 1; }
  @media (max-width: 860px) { .pdf-sheet { min-height: 0; } .pdf-packages { grid-template-columns: 1fr; } .pdf-package { min-height: auto; max-width: 360px; margin: 0 auto; } .price { margin-top: 1.2rem; } .pdf-contact { flex-direction: column; align-items: center; text-align: center; } }
  @media (max-width: 560px) { .pdf-topbar { flex-direction: column; align-items: center; text-align: center; } .pdf-title p { letter-spacing: 0.28em; } .pdf-sheet { margin-top: 1.2rem; } }
</style>
