---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="charlexdew" description="charlexdew">
  <main class="terminal" aria-label="terminal landing page">
    <p class="prompt"><span aria-hidden="true">$</span> charlexdew</p>
    <h1>I'm green</h1>
    <span class="cursor" aria-hidden="true"></span>
  </main>
</BaseLayout>

<style>
  .terminal {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: 0.65rem;
    padding: 2rem;
    text-shadow: 0 0 10px rgba(0, 255, 102, 0.65), 0 0 28px rgba(0, 255, 102, 0.24);
  }

  .prompt,
  h1 {
    margin: 0;
  }

  .prompt {
    color: rgba(0, 255, 102, 0.78);
    font-size: clamp(0.9rem, 2vw, 1.15rem);
  }

  h1 {
    font-size: clamp(2.2rem, 8vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .cursor {
    width: clamp(0.75rem, 2vw, 1.3rem);
    height: clamp(1.3rem, 5vw, 4.6rem);
    background: #00ff66;
    box-shadow: 0 0 18px rgba(0, 255, 102, 0.75);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>
