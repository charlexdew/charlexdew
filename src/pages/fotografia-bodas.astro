---
import WeddingLayout from '../layouts/WeddingLayout.astro';

const packages = [
  {
    name: 'Standard',
    price: '$300',
    tone: 'Ceremonia + recepción',
    features: [
      'Cobertura de ceremonia en fotografía y video — 2 horas',
      'Cobertura de recepción en fotografía y video — 3 horas',
      '150 fotos editadas y digitales',
      '1 video resumen de 3 minutos',
    ],
  },
  {
    name: 'Premium',
    price: '$400',
    tone: 'Pre-boda + 6 horas',
    featured: true,
    features: [
      'Sesión pre-boda al aire libre de 60 minutos*',
      'Incluye 10 fotos de la sesión pre-boda',
      '6 horas de cobertura en fotografía y video para ceremonia y recepción',
      '250 fotos editadas y digitales',
      '1 video de 5 minutos',
    ],
  },
  {
    name: 'Gold',
    price: '$600',
    tone: 'Cobertura completa',
    features: [
      'Sesión pre-boda al aire libre de 90 minutos*',
      'Incluye 20 fotos de la sesión pre-boda',
      '8 horas de cobertura de todo el evento: preparación, ceremonia y recepción',
      'Tomas de drone',
      '350 fotos editadas y digitales',
      '1 a 2 videos resumen — 3 minutos en total',
      '1 video de 10 minutos',
    ],
  },
];

const coverage = [
  'Ceremonias religiosas',
  'Bodas civiles',
  'Recepción y celebración',
  'Preparación de los novios',
  'Sesiones pre-boda',
  'Fotografía y video',
];
---
<WeddingLayout
  title="Fotografía de bodas por Sami & Abi"
  description="Servicios de fotografía y video para bodas religiosas, bodas civiles, recepción y celebraciones por Sami Veliz y Abigail Ramírez."
>
  <section class="wedding-hero">
    <div class="hero-copy">
      <p class="eyebrow">Fotografía & video de boda</p>
      <h1>Sami <span>&</span> Abi</h1>
      <p class="lede">
        Cobertura luminosa, romántica y natural para contar la historia completa de tu boda:
        desde la ceremonia religiosa o civil hasta la recepción, los abrazos, la fiesta y los detalles que no se repiten.
      </p>
      <div class="hero-actions">
        <a class="cta primary" href="mailto:abigailrfotografia@hotmail.com?subject=Consulta%20cobertura%20de%20boda%20Sami%20%26%20Abi">Consultar disponibilidad</a>
        <a class="cta" href="tel:+593979160057">Llamar 0979160057</a>
      </div>
    </div>
    <aside class="hero-card" aria-label="Resumen de cobertura">
      <div class="photo-frame">
        <span class="ring one"></span>
        <span class="ring two"></span>
        <span class="bloom">✽</span>
      </div>
      <span class="script">Wedding stories</span>
      <h2>Imágenes suaves para recordar un día único.</h2>
      <p>Paquetes desde <strong>$300</strong> con entrega digital editada y videos resumen.</p>
      <div class="mini-grid">
        <span>Civil</span>
        <span>Religiosa</span>
        <span>Recepción</span>
        <span>Pre-boda</span>
      </div>
    </aside>
  </section>

  <section class="intro panel-soft">
    <p class="eyebrow">Cobertura pensada para bodas reales</p>
    <h2>Religiosa, civil, recepción y todo lo que sucede entre momentos.</h2>
    <p>
      Sami Veliz y Abigail Ramírez cubren eventos con fotografía y video, cuidando tanto los instantes grandes como los detalles íntimos: miradas, familia, entrada, votos, brindis, baile y celebración.
    </p>
    <div class="coverage-list" aria-label="Tipos de cobertura">
      {coverage.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section id="paquetes" class="packages" aria-label="Paquetes de cobertura de boda">
    <div class="section-heading">
      <p class="eyebrow">Paquetes</p>
      <h2>Elige la cobertura que mejor se adapta a tu día.</h2>
    </div>
    <div class="package-grid">
      {packages.map((item) => (
        <article class:list={['package-card', { featured: item.featured }]}>
          {item.featured && <span class="badge">Más solicitado</span>}
          <p class="package-tone">{item.tone}</p>
          <h3>{item.name}</h3>
          <p class="price">{item.price}</p>
          <ul>
            {item.features.map((feature) => <li>{feature}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <p class="note">
      *La sesión pre-boda debe realizarse el mismo día del evento. Si se agenda para una fecha diferente, se aplicará un cargo adicional.
    </p>
  </section>

  <section id="reserva" class="process panel-soft">
    <div>
      <p class="eyebrow">Reserva y entrega</p>
      <h2>Un proceso sencillo para asegurar tu fecha.</h2>
    </div>
    <div class="steps">
      <article>
        <span>01</span>
        <h3>Reserva</h3>
        <p>Cualquiera de los paquetes se reserva con el 50% de anticipo.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Evento</h3>
        <p>El 50% restante se cancela el día del evento o antes de la entrega final del material.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Entrega</h3>
        <p>El material final se entrega de 3 a 4 semanas después de la boda.</p>
      </article>
    </div>
  </section>

  <section id="contacto" class="contact-card">
    <p class="eyebrow">Agenda tu fecha</p>
    <h2>Hablemos de tu boda.</h2>
    <p>
      Escríbenos para confirmar disponibilidad, tipo de ceremonia, horario, lugar y el paquete que más te interesa.
    </p>
    <div class="contact-actions">
      <a class="cta primary" href="mailto:abigailrfotografia@hotmail.com?subject=Consulta%20cobertura%20de%20boda%20Sami%20%26%20Abi">abigailrfotografia@hotmail.com</a>
      <a class="cta" href="mailto:samantaveliz92@gmail.com?subject=Consulta%20cobertura%20de%20boda%20Sami%20%26%20Abi">samantaveliz92@gmail.com</a>
      <a class="cta" href="tel:+593987896284">0987896284</a>
      <a class="cta" href="tel:+593979160057">0979160057</a>
    </div>
  </section>
</WeddingLayout>

<style>
  :global(body) {
    --wedding-ink: #3f332c;
    --wedding-muted: #74665d;
    --wedding-ivory: #fffdf8;
    --wedding-cream: #fbf7f0;
    --wedding-blush: #efd9d1;
    --wedding-blush-strong: #c88f82;
    --wedding-sage: #87977d;
    --wedding-gold: #b68a4a;
    --wedding-line: rgba(90, 67, 52, 0.16);
    color: var(--wedding-ink);
    background:
      radial-gradient(circle at 12% 5%, rgba(239, 217, 209, 0.7), transparent 23rem),
      radial-gradient(circle at 90% 12%, rgba(219, 225, 203, 0.75), transparent 25rem),
      linear-gradient(180deg, #fffdf8 0%, #fbf7f0 42%, #f7eee6 100%);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  :global(body)::before {
    opacity: 0.22;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(182, 138, 74, 0.18) 1px, transparent 0);
    background-size: 30px 30px;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
  }

  .wedding-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(310px, 0.78fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(4.5rem, 10vw, 8rem) 0 3.5rem;
    position: relative;
  }

  .wedding-hero::before,
  .wedding-hero::after {
    content: '❦';
    position: absolute;
    color: rgba(200, 143, 130, 0.22);
    font-size: clamp(4rem, 12vw, 10rem);
    line-height: 1;
    pointer-events: none;
  }

  .wedding-hero::before { top: 2.5rem; right: 47%; transform: rotate(-18deg); }
  .wedding-hero::after { bottom: -1rem; left: 4%; transform: rotate(15deg); }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--wedding-sage);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.76rem;
    font-weight: 800;
  }

  h1, h2, h3, p { text-wrap: pretty; }

  h1 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4.4rem, 15vw, 10.8rem);
    line-height: 0.82;
    letter-spacing: -0.085em;
    color: var(--wedding-ink);
    text-shadow: 0 18px 50px rgba(90, 67, 52, 0.12);
  }

  h1 span {
    display: inline-block;
    color: var(--wedding-blush-strong);
    font-family: 'Brush Script MT', 'Segoe Script', cursive;
    font-size: 0.58em;
    letter-spacing: -0.02em;
    transform: translateY(-0.06em) rotate(-6deg);
  }

  .lede {
    max-width: 66ch;
    color: var(--wedding-muted);
    font-size: clamp(1.08rem, 2vw, 1.32rem);
    line-height: 1.85;
    margin: 1.4rem 0 0;
  }

  .hero-actions, .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(90, 67, 52, 0.16);
    border-radius: 999px;
    padding: 0.88rem 1.15rem;
    color: var(--wedding-ink);
    background: rgba(255, 253, 248, 0.7);
    box-shadow: 0 14px 34px rgba(90, 67, 52, 0.08);
    font-weight: 800;
  }

  .cta.primary {
    color: #fffdf8;
    background: linear-gradient(135deg, var(--wedding-sage), #6f8166);
    border-color: transparent;
  }

  .hero-card, .panel-soft, .package-card, .contact-card {
    border: 1px solid var(--wedding-line);
    background: rgba(255, 253, 248, 0.78);
    box-shadow:
      0 28px 80px rgba(90, 67, 52, 0.1),
      0 2px 0 rgba(255, 255, 255, 0.75) inset;
    backdrop-filter: blur(18px);
  }

  .hero-card {
    min-height: 540px;
    border-radius: 38px;
    padding: 1.15rem;
    display: grid;
    grid-template-rows: 1fr auto;
    position: relative;
    overflow: hidden;
  }

  .hero-card::before {
    content: '';
    position: absolute;
    inset: 1.15rem;
    border: 1px solid rgba(182, 138, 74, 0.22);
    border-radius: 30px;
    pointer-events: none;
    z-index: 2;
  }

  .photo-frame {
    min-height: 260px;
    border-radius: 30px 30px 18px 18px;
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(145deg, rgba(255,255,255,0.3), transparent 45%),
      radial-gradient(circle at 50% 20%, rgba(255, 253, 248, 0.95) 0 5rem, transparent 5.1rem),
      linear-gradient(135deg, rgba(239, 217, 209, 0.9), rgba(219, 225, 203, 0.85));
    border: 1px solid rgba(90, 67, 52, 0.1);
  }

  .photo-frame::before,
  .photo-frame::after {
    content: '';
    position: absolute;
    border-radius: 999px 999px 0 0;
    border: 1px solid rgba(90, 67, 52, 0.18);
    background: rgba(255, 253, 248, 0.28);
  }

  .photo-frame::before { width: 58%; height: 82%; left: 8%; bottom: -20%; transform: rotate(-8deg); }
  .photo-frame::after { width: 54%; height: 76%; right: 7%; bottom: -18%; transform: rotate(7deg); }

  .ring {
    position: absolute;
    width: 5rem;
    height: 5rem;
    border: 7px solid rgba(182, 138, 74, 0.74);
    border-radius: 50%;
    bottom: 2.2rem;
    z-index: 1;
    box-shadow: 0 18px 35px rgba(90, 67, 52, 0.12);
  }

  .ring.one { left: 42%; }
  .ring.two { right: 31%; border-color: rgba(200, 143, 130, 0.66); }
  .bloom { position: absolute; top: 2rem; right: 2.2rem; color: rgba(200, 143, 130, 0.68); font-size: 4rem; }

  .script {
    margin: 1.4rem 1rem 0;
    font-family: 'Brush Script MT', 'Segoe Script', cursive;
    color: var(--wedding-blush-strong);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .hero-card h2 {
    color: var(--wedding-ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1;
    margin: 0.4rem 1rem 0.8rem;
    letter-spacing: -0.045em;
  }

  .hero-card p { color: var(--wedding-muted); line-height: 1.7; margin: 0 1rem; }
  .hero-card strong { color: var(--wedding-gold); }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
    margin: 1.2rem 1rem 1rem;
  }

  .mini-grid span {
    border: 1px solid rgba(90, 67, 52, 0.12);
    border-radius: 999px;
    padding: 0.65rem;
    text-align: center;
    color: var(--wedding-ink);
    background: #fffdf8;
    font-weight: 700;
  }

  .intro, .process, .contact-card {
    border-radius: 34px;
    padding: clamp(1.5rem, 3.5vw, 2.6rem);
    margin: 2rem 0;
  }

  .intro h2, .process h2, .contact-card h2, .section-heading h2 {
    margin: 0;
    max-width: 850px;
    font-family: Georgia, 'Times New Roman', serif;
    color: var(--wedding-ink);
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .intro p:not(.eyebrow), .contact-card p, .process p, .note {
    color: var(--wedding-muted);
    line-height: 1.75;
  }

  .coverage-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.4rem;
  }

  .coverage-list span {
    border: 1px solid rgba(135, 151, 125, 0.26);
    border-radius: 999px;
    padding: 0.65rem 0.85rem;
    color: #52604b;
    background: rgba(219, 225, 203, 0.6);
    font-weight: 900;
  }

  .packages { padding: 3.4rem 0; }
  .section-heading { margin-bottom: 1.6rem; }

  .package-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .package-card {
    border-radius: 30px;
    padding: 1.4rem;
    position: relative;
    overflow: hidden;
  }

  .package-card::after {
    content: '✦';
    position: absolute;
    right: 1.2rem;
    top: 1rem;
    color: rgba(182, 138, 74, 0.22);
    font-size: 3rem;
  }

  .package-card.featured {
    background: linear-gradient(180deg, #fffdf8, #f5ebe3);
    border-color: rgba(200, 143, 130, 0.4);
    transform: translateY(-0.6rem);
  }

  .badge {
    display: inline-flex;
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    color: #fffdf8;
    background: var(--wedding-blush-strong);
    font-weight: 900;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .package-tone {
    color: var(--wedding-sage);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 900;
  }

  .package-card h3 {
    margin: 0.2rem 0;
    color: var(--wedding-ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2.25rem;
    letter-spacing: -0.04em;
  }

  .price {
    margin: 0.35rem 0 1rem;
    color: var(--wedding-gold);
    font-size: 2.55rem;
    font-weight: 950;
  }

  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  li { color: var(--wedding-muted); line-height: 1.55; padding-left: 1.45rem; position: relative; }
  li::before { content: '✓'; position: absolute; left: 0; color: var(--wedding-sage); font-weight: 900; }

  .process {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 1.4rem;
  }

  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.85rem; }
  .steps article { border: 1px solid rgba(90, 67, 52, 0.12); border-radius: 24px; padding: 1rem; background: #fffdf8; }
  .steps span { color: var(--wedding-blush-strong); font-weight: 950; }
  .steps h3 { color: var(--wedding-ink); margin: 0.4rem 0; }

  .contact-card {
    text-align: center;
    margin-bottom: 0;
    background:
      linear-gradient(135deg, rgba(255,253,248,0.92), rgba(239,217,209,0.52)),
      radial-gradient(circle at 15% 20%, rgba(219,225,203,0.55), transparent 16rem);
  }

  .contact-card h2, .contact-card p { margin-left: auto; margin-right: auto; }
  .contact-card p { max-width: 68ch; }
  .contact-actions { justify-content: center; }

  @media (max-width: 900px) {
    :global(.site-header) { border-radius: 24px; }
    .wedding-hero, .process { grid-template-columns: 1fr; }
    .package-grid, .steps { grid-template-columns: 1fr; }
    .package-card.featured { transform: none; }
    .hero-card { min-height: auto; }
  }

  @media (max-width: 560px) {
    h1 { font-size: clamp(3.7rem, 20vw, 5.4rem); }
    .contact-actions .cta, .hero-actions .cta { width: 100%; }
    .mini-grid { grid-template-columns: 1fr; }
    .ring { width: 4rem; height: 4rem; }
  }
</style>
