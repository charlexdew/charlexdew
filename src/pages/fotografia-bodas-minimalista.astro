---
import WeddingLayout from '../layouts/WeddingLayout.astro';

const packages = [
  {
    name: 'Standard',
    price: '$300',
    tone: 'Ceremonia + recepción',
    features: [
      'Cobertura de ceremonia en fotografía y video — 2 horas',
      'Cobertura de recepción en fotografía y video — 3 horas',
      '150 fotos editadas y digitales',
      '1 video resumen de 3 minutos',
    ],
  },
  {
    name: 'Premium',
    price: '$400',
    tone: 'Pre-boda + 6 horas',
    featured: true,
    features: [
      'Sesión pre-boda al aire libre de 60 minutos*',
      'Incluye 10 fotos de la sesión pre-boda',
      '6 horas de cobertura en fotografía y video para ceremonia y recepción',
      '250 fotos editadas y digitales',
      '1 video de 5 minutos',
    ],
  },
  {
    name: 'Gold',
    price: '$600',
    tone: 'Cobertura completa',
    features: [
      'Sesión pre-boda al aire libre de 90 minutos*',
      'Incluye 20 fotos de la sesión pre-boda',
      '8 horas de cobertura de todo el evento: preparación, ceremonia y recepción',
      'Tomas de drone',
      '350 fotos editadas y digitales',
      '1 a 2 videos resumen — 3 minutos en total',
      '1 video de 10 minutos',
    ],
  },
];

const coverage = [
  'Ceremonias religiosas',
  'Bodas civiles',
  'Recepción y celebración',
  'Preparación de los novios',
  'Sesiones pre-boda',
  'Fotografía y video',
];
---
<WeddingLayout
  title="Fotografía de bodas minimalista por Sami & Abi"
  description="Versión minimalista de los servicios de fotografía y video para bodas religiosas, bodas civiles, recepción y celebraciones por Sami Veliz y Abigail Ramírez."
>
  <section class="minimal-hero">
    <p class="eyebrow">Sami Veliz / Abigail Ramírez</p>
    <h1>Fotografía y video para bodas.</h1>
    <p class="lede">
      Cobertura clara, cuidada y sin distracciones para ceremonia religiosa, boda civil,
      recepción, preparación y sesiones pre-boda.
    </p>
    <div class="hero-actions">
      <a class="button primary" href="mailto:abigailrfotografia@hotmail.com?subject=Consulta%20cobertura%20de%20boda%20Sami%20%26%20Abi">Consultar disponibilidad</a>
      <a class="button" href="#paquetes">Ver paquetes</a>
    </div>
  </section>

  <section class="coverage-strip" aria-label="Tipos de cobertura">
    {coverage.map((item) => <span>{item}</span>)}
  </section>

  <section id="paquetes" class="packages" aria-label="Paquetes de cobertura de boda">
    <div class="section-heading">
      <p class="eyebrow">Paquetes</p>
      <h2>Tres niveles de cobertura.</h2>
    </div>
    <div class="package-list">
      {packages.map((item) => (
        <article class:list={['package-row', { featured: item.featured }]}>
          <div>
            {item.featured && <span class="badge">Más solicitado</span>}
            <p class="package-tone">{item.tone}</p>
            <h3>{item.name}</h3>
          </div>
          <ul>
            {item.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <p class="price">{item.price}</p>
        </article>
      ))}
    </div>
    <p class="note">*La sesión pre-boda debe realizarse el mismo día del evento. Si se agenda para una fecha diferente, se aplicará un cargo adicional.</p>
  </section>

  <section id="reserva" class="process">
    <div class="section-heading compact">
      <p class="eyebrow">Reserva</p>
      <h2>Simple y transparente.</h2>
    </div>
    <div class="steps">
      <article><span>01</span><h3>Anticipo</h3><p>Cualquiera de los paquetes se reserva con el 50% de anticipo.</p></article>
      <article><span>02</span><h3>Saldo</h3><p>El 50% restante se cancela el día del evento o antes de la entrega final.</p></article>
      <article><span>03</span><h3>Entrega</h3><p>El material final se entrega de 3 a 4 semanas después de la boda.</p></article>
    </div>
  </section>

  <section id="contacto" class="contact-card">
    <p class="eyebrow">Contacto</p>
    <h2>Agenda tu fecha.</h2>
    <div class="contact-actions">
      <a class="button primary" href="mailto:abigailrfotografia@hotmail.com?subject=Consulta%20cobertura%20de%20boda%20Sami%20%26%20Abi">abigailrfotografia@hotmail.com</a>
      <a class="button" href="mailto:samantaveliz92@gmail.com?subject=Consulta%20cobertura%20de%20boda%20Sami%20%26%20Abi">samantaveliz92@gmail.com</a>
      <a class="button" href="tel:+593987896284">0987896284</a>
      <a class="button" href="tel:+593979160057">0979160057</a>
    </div>
  </section>
</WeddingLayout>

<style>
  :global(body) { --ink: #090909; --muted: #626262; --line: #dedede; --surface: #ffffff; color: var(--ink); background: #f7f7f5; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  :global(body)::before { opacity: 0; }
  .minimal-hero { padding: clamp(5rem, 13vw, 10rem) 0 clamp(4rem, 8vw, 7rem); border-bottom: 1px solid var(--line); }
  .eyebrow { margin: 0 0 1rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.22em; font-size: 0.72rem; font-weight: 800; }
  h1, h2, h3, p { text-wrap: pretty; }
  h1 { max-width: 1020px; margin: 0; font-size: clamp(4rem, 11vw, 10rem); line-height: 0.9; letter-spacing: -0.085em; font-weight: 850; }
  .lede { max-width: 760px; margin: 1.5rem 0 0; color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.42rem); line-height: 1.7; }
  .hero-actions, .contact-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.8rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; border: 1px solid var(--line); border-radius: 999px; padding: 0.72rem 1.1rem; color: var(--ink); background: var(--surface); font-weight: 800; }
  .button.primary { background: var(--ink); color: #fff; border-color: var(--ink); }
  .coverage-strip { display: flex; flex-wrap: wrap; gap: 0.55rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .coverage-strip span { border: 1px solid var(--line); border-radius: 999px; background: #fff; padding: 0.55rem 0.75rem; color: var(--muted); font-size: 0.86rem; font-weight: 700; }
  .packages, .process, .contact-card { padding: clamp(3rem, 8vw, 6.5rem) 0; border-bottom: 1px solid var(--line); }
  .section-heading { display: grid; grid-template-columns: 0.32fr 1fr; gap: 1rem; align-items: start; margin-bottom: 2rem; }
  .section-heading h2 { margin: 0; font-size: clamp(2.4rem, 6vw, 5.4rem); line-height: 0.95; letter-spacing: -0.07em; }
  .package-list { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .package-row { display: grid; grid-template-columns: 0.8fr 1.45fr auto; gap: clamp(1rem, 4vw, 3rem); align-items: start; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .package-row.featured { background: linear-gradient(90deg, rgba(255,255,255,0.9), transparent); }
  .badge { display: inline-flex; border-radius: 999px; padding: 0.36rem 0.56rem; margin-bottom: 0.72rem; background: var(--ink); color: #fff; font-size: 0.72rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.07em; }
  .package-tone { margin: 0 0 0.3rem; color: var(--muted); font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; }
  .package-row h3 { margin: 0; font-size: clamp(1.8rem, 4vw, 3rem); letter-spacing: -0.055em; }
  .price { margin: 0; font-size: clamp(2.2rem, 5vw, 4rem); letter-spacing: -0.06em; font-weight: 820; }
  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.62rem; }
  li { color: var(--muted); line-height: 1.55; }
  .note { color: var(--muted); margin: 1rem 0 0; line-height: 1.7; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .steps article { background: #fff; padding: 1rem; }
  .steps span { color: var(--muted); font-size: 0.78rem; font-weight: 900; }
  .steps h3 { margin: 0.4rem 0; font-size: 1.35rem; }
  .steps p { color: var(--muted); line-height: 1.65; }
  .contact-card { border-bottom: 0; }
  .contact-card h2 { margin: 0; font-size: clamp(3rem, 8vw, 7rem); line-height: 0.9; letter-spacing: -0.08em; }
  @media (max-width: 860px) { .section-heading, .package-row { grid-template-columns: 1fr; } .steps { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .hero-actions .button, .contact-actions .button { width: 100%; } h1 { font-size: clamp(3.4rem, 18vw, 5rem); } }
</style>
